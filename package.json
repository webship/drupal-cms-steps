{
  "name": "@webship-js/drupal-cms-steps",
  "version": "2.0.0-beta1",
  "description": "Drupal CMS specific Cucumber step definitions plugin for webship-js: the Navigation toolbar and dashboard, Drupal CMS content types and recipes, user management specifics and Drupal Canvas (editor and API), on top of @webship-js/drupal-core-steps.",
  "main": "tests/step-definitions/drupal-cms.steps.js",
  "files": [
    "tests/step-definitions/drupal-cms.steps.js",
    "tests/step-definitions/drupal-canvas.steps.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports"
  },
  "keywords": [
    "webship-js",
    "drupal",
    "drupal-cms",
    "drupal-canvas",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "gherkin",
    "step-definitions",
    "drupal-testing",
    "e2e-testing"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/drupal-cms-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/drupal-cms-steps/issues"
  },
  "homepage": "https://github.com/webship/drupal-cms-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "devDependencies": {
    "@webship-js/drupal-core-steps": "^2.0.0-beta1",
    "tsx": "^4.19.2",
    "webship-js": "^2.0.6"
  },
  "peerDependencies": {
    "@webship-js/drupal-core-steps": "^2.0.0-beta1",
    "webship-js": "^2.0.6"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
